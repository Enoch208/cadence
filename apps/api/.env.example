DATABASE_URL=postgres://cadence:cadence@127.0.0.1:54340/cadence
PORT=8810
# The origin members open. Every mutation must carry it as Origin, and /api on it must be proxied
# to this API so the session cookie stays first-party.
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5190
# At least 32 characters, for example: openssl rand -hex 32
SESSION_SECRET=
# 64 hex characters (32 bytes) that seal delegated Strike keys: openssl rand -hex 32
KEY_ENCRYPTION_KEY=
# Raise only together with a new KEY_ENCRYPTION_KEY; accounts sealed under the old key must reconnect.
KEY_ENCRYPTION_KEY_VERSION=1
# Bot token from @BotFather. The webhook secret Telegram must send is derived from it, so there is no
# second secret to set; register the webhook with pnpm --filter @cadence/api telegram:set-webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STRIKE_API_BASE=https://api.strikefinance.org
# Largest notional in USD the worker will ever submit, checked before every order. No default.
CADENCE_LIVE_MAX_NOTIONAL=
# Builder code registered at app.strikefinance.org/builder-codes. Unset, members can only paste a key.
STRIKE_BUILDER_CODE=
# OpenAI API key for drafting a plan from a curator's message. Unset, drafting is off.
OPENAI_API_KEY=
