DATABASE_URL=postgres://cadence:cadence@127.0.0.1:54340/cadence
KEY_ENCRYPTION_KEY=
KEY_ENCRYPTION_KEY_VERSION=1
STRIKE_API_BASE=https://api.strikefinance.org
CADENCE_LIVE_MAX_NOTIONAL=25
# Bot token from @BotFather, the same one the API uses. Unset, order messages are off: they stay
# queued as pending in the database, unsent and harmless, until a worker with a token runs.
TELEGRAM_BOT_TOKEN=
# The origin members open, the same as the API's. Required once TELEGRAM_BOT_TOKEN is set, because
# every order message links to the order or its receipt there.
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5190
